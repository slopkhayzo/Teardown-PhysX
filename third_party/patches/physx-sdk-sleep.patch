+
+// TeardownPhysX diagnostics: the actor of a low-level rigid body (an island node's object, see gSleepDebugObject)
+namespace physx
+{
+PxActor* PxDebugActorOfRigid(const void* rigid)
+{
+	if(!rigid)
+		return NULL;
+	Sc::BodySim* sim = reinterpret_cast<Sc::BodySim*>(const_cast<PxU8*>(reinterpret_cast<const PxU8*>(rigid)) - Sc::BodySim::getRigidBodyOffset());
+	return sim->getBodyCore().getPxActor();
+}
+}
