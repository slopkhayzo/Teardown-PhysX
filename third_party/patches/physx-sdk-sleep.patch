+// TeardownPhysX diagnostics, off while gSleepDebugMinNodes is 0: the biggest island of at least that many bodies that
+// the last deactivation pass of each island sim kept awake, and why ([0] the accurate island sim, which puts bodies to
+// sleep; [1] the speculative one, which keeps their contact pairs going). Plain globals: the island classes' layout is
+// compiled into PhysXGpu_64.dll and must not change.
+struct SleepDebugInfo
+{
+	PxU32 islandNodes;		// that island's bodies (0: none this step)
+	PxU32 reason;			// 1: an active kinematic not ready to sleep touches it, 2: bodies not ready
+	PxU32 notReady;			// its bodies not ready to sleep
+	const void* object;		// the kinematic, or the first body not ready (a PxsRigidBody)
+	PxU32 flags;			// that node's flags
+	PxReal wakeCounter, solverWakeCounter, speed;
+};
+PxU32 gSleepDebugMinNodes = 0;
+const void* gSleepDebugSim = NULL;		// the accurate island sim (SimpleIslandManager::thirdPassIslandGen)
+const void* gSleepDebugSpecSim = NULL;	// the speculative one
+SleepDebugInfo gSleepDebugInfo[2] = {};
+// Called (when set) whenever the accurate island sim is told that a dynamic body that was ready to sleep no longer is:
+// the low-level body (a PxsRigidBody) and its wake counter at that moment.
+void (*gActivateDebugHook)(const void* rigid, PxReal wakeCounter) = NULL;
+// Sleeping islands of at least gSleepDebugMinNodes bodies the accurate island sim woke (the plugin reads and clears
+// these), by cause: 0 a body of the island woke, 1 a kinematic touching one of its bodies woke, 2 a new contact with an
+// active kinematic, 3 a new contact with an awake body or island; and the node that did it the last time (its mObject:
+// a PxsRigidBody).
+PxU32 gWakeDebugCount[4] = {0, 0, 0, 0};
+const void* gWakeDebugObject[4] = {NULL, NULL, NULL, NULL};
+}
+}
 
 using namespace physx;
+
+namespace
+{
+PX_FORCE_INLINE void noteIslandWake(bool accurate, PxU32 islandBodies, PxU32 cause, const void* object)
+{
+	if(accurate && IG::gSleepDebugMinNodes && islandBodies >= IG::gSleepDebugMinNodes)
+	{
+		IG::gWakeDebugCount[cause]++;
+		IG::gWakeDebugObject[cause] = object;
+	}
+}
+}
